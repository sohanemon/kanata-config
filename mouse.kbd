;; NOTE: j/k are speed modifiers on mouse_layer — drop them from the `'` tap-hold tap keys
;;       so pressing them does not cancel mouse_layer into a literal apostrophe
(defvar
  mouse-tap-keys (
    6    7    8    9    0    -    =    bspc  grv
    y    u    i    o    p    [    ]    \    del
    h    l    scln '    ret  pgup
    n    m    ,    .    /    rsft up   pgdn
          ralt rmet rctl
    )
  )

(defalias
  mwu (mwheel-up 50 120)
  mwd (mwheel-down 50 120)
  mwl (mwheel-left 50 120)
  mwr (mwheel-right 50 120)

  ;; NOTE: movemouse args = interval(ms) distance(px). base 2px/3ms; j=50% -> 1px, k=300% -> 6px
  ms↑ (movemouse-up 3 2)
  ms← (movemouse-left 3 2)
  ms↓ (movemouse-down 3 2)
  ms→ (movemouse-right 3 2)

  msleft (macro
            (movemouse-left 100 30000)
            (10)
            (movemouse-left 100 100)
          )
  msright (macro
            (movemouse-right 100 30000)
            10
            (movemouse-right 100 100)
            )

  )

(deflayermap (mouse_layer)
  j   (movemouse-speed 50)
  k   (movemouse-speed 300)

  e   @ms↑
  s   @ms←
  d   @ms↓
  f   @ms→

  _   XX

  spc  mlft
  caps mlft
  lsft mrgt
  tab  mmid
)
