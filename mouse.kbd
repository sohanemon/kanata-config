(defalias
  ;; NOTE: mwheel args = interval(ms) distance(120 = one notch). j=50%, k=300% via mousewheel-speed
  mwu (mwheel-up 50 60)
  mwd (mwheel-down 50 60)
  mwl (mwheel-left 50 60)
  mwr (mwheel-right 50 60)

  ;; NOTE: movemouse args = interval(ms) distance(px). base 2px/3ms; j=50% -> 1px, k=300% -> 6px
  ms↑ (movemouse-up 3 2)
  ms← (movemouse-left 3 2)
  ms↓ (movemouse-down 3 2)
  ms→ (movemouse-right 3 2)

  msleft (macro
            (movemouse-left 100 30000)
            (10)
            (movemouse-left 100 100)
          )
  msright (macro
            (movemouse-right 100 30000)
            10
            (movemouse-right 100 100)
            )

  )

(deflayermap (mouse_layer)
  ;; NOTE: j/k scale movement + scroll: j=50%, k=300%
  j   (multi (movemouse-speed 50) (mousewheel-speed 20))
  k   (multi (movemouse-speed 200) (mousewheel-speed 150))
  l   (multi (movemouse-speed 300) (mousewheel-speed 300))

  e   @ms↑
  s   @ms←
  d   @ms↓
  f   @ms→

  ;; scroll
  q   @mwu
  a   @mwd
  w   @mwl
  r   @mwr

  _   XX

  spc  mlft
  caps mlft
  lsft mrgt
  tab  mmid
)
