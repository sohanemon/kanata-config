;; Combos/Input Chords v2
(defchordsv2
  ;; explicit Caps Lock toggle: both Shift keys pressed together within 150 ms.
  ;; A slow hold of one Shift then the other (e.g. autoscroll + Shift) misses the
  ;; chord window, so it no longer toggles Caps Lock accidentally.
  (lsft rsft) caps $lht all-released  ()

  (a scln) ret $tt all-released  ()
  ;; (d k) (macro M-spc 50 spc) $tt all-released  ()
  ;; montitors
  ;; (f j) (macro (movemouse-left 100 30000) 100 (movemouse-left 100 100) 100 (movemouse-right 50 50) 100 M-C-A-0) $tt all-released  ()
  ;; (d k) (macro (movemouse-right 100 30000) 100 (movemouse-right 100 100) 100 M-C-A-1) $tt all-released  ()
  ;; (s l) (macro (movemouse-right 100 30000) 100 (movemouse-right 100 100) 100 (movemouse-left 50 50) 100 M-C-A-2) $tt all-released  ()

)
