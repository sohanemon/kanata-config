(defalias
  ;; vim layer-while-held
  vim (layer-while-held vim_layer)
  space (tap-hold-release $tt $lht spc @vim)

  ;; navigation layer-while-held
  tab (tap-hold-release $tt $ht tab (multi lctl lmet lalt (layer-while-held tab_layer)))
  ;; so, tab+x is ctrl+super+alt+x

  ;; functions 
  grv (tap-hold-release $tt $ht grv (multi lctl lmet (layer-while-held grv_layer)))
  ;; so, grv+x is ctrl+super+x

  ;; ctrl is so far to use
  caps (tap-hold-release $tt $ht esc (multi lctl lalt (layer-while-held caps_layer)))
  ;; so caps+x is ctrl+alt+x

  ;; super + shift is now only return
  ret (tap-hold-release $tt $ht ret (multi lmet lsft (layer-while-held ret_layer)))
   ;; so, ret+x is super+shift+x


  ;; single click action meta
  meta (tap-hold-release 0 $ht M-A-tab _)

  sup (layer-while-held super_layer)

  app (tap-hold-release $tt $ht _ (multi lmet lsft lalt))
  ;; so, app+x press is x and app(hold)+x is shift+super+alt+x

  lalt (multi
         lalt
        (layer-while-held alt_layer)
         )
  ralt (multi
         ralt
        (layer-while-held alt_layer)
         )
  rctl (multi
         rctl
        (layer-while-held command_layer)
         )
  lctl (multi
         lctl
        (layer-while-held command_layer)
         )

  )

(defaliasenvcond (KANATA_TOUCHPAD_MOD 1)
  ;; NOTE: Enable mouse-button holds only when touchpad mode is requested.
  draw-mod (tap-hold-release $tt $ht use-defsrc (multi use-defsrc mlft))
  scroll-mod (tap-hold-release $tt $ht use-defsrc (multi use-defsrc mmid))
)

(defaliasenvcond (KANATA_TOUCHPAD_MOD 0)
  draw-mod use-defsrc
  scroll-mod use-defsrc
)

(defalias

  ;; NOTE: Resolve opposite-hand holds after the interrupting key is released to avoid fast-roll misfires.
  a (tap-hold-opposite-hand-release $ht _ (multi lmet @sup) (same-hand tap) (unknown-hand hold) (timeout hold) (tap-repress-timeout $tt))
  s (tap-hold-opposite-hand-release $ht _ @lalt (same-hand tap) (unknown-hand hold) (timeout hold) (tap-repress-timeout $tt))
  d (tap-hold-opposite-hand-release $ht _ lsft (same-hand tap) (unknown-hand hold) (timeout hold) (tap-repress-timeout $tt))
  f (tap-hold-opposite-hand-release $ht _ @lctl (same-hand tap) (unknown-hand hold) (timeout hold) (tap-repress-timeout $tt))
  g (tap-hold-opposite-hand-release $ht _ @app (same-hand tap) (unknown-hand hold) (timeout hold) (tap-repress-timeout $tt))

  h (tap-hold-opposite-hand-release $ht _ @app (same-hand tap) (unknown-hand hold) (timeout hold) (tap-repress-timeout $tt))
  j (tap-hold-opposite-hand-release $ht _ @rctl (same-hand tap) (unknown-hand hold) (timeout hold) (tap-repress-timeout $tt))
  k (tap-hold-opposite-hand-release $ht _ rsft (same-hand tap) (unknown-hand hold) (timeout hold) (tap-repress-timeout $tt))
  l (tap-hold-opposite-hand-release $ht _ @ralt (same-hand tap) (unknown-hand hold) (timeout hold) (tap-repress-timeout $tt))

  scln (tap-hold-opposite-hand-release $ht (fork _ (multi _ sldr) (lsft rsft)) (multi rmet @sup) (same-hand tap) (unknown-hand hold) (timeout hold) (tap-repress-timeout $tt))

  ' (tap-hold-opposite-hand-release $ht _ (layer-while-held mouse_layer) (same-hand tap) (unknown-hand hold) (timeout hold) (tap-repress-timeout $tt))

  ;; montitors
  left_monitor (macro (movemouse-left 100 30000) 100 (movemouse-left 100 100) 100 (movemouse-left 100 100))
  right_monitor (macro (movemouse-right 100 30000) 100 (movemouse-right 100 100) 100 (movemouse-right 100 100))
  )
